#!/bin/sh
mkdir -p /mnt/app_logs/
cp -R /usr/share/x6100/images /dev/shm/
while true; do
    # an update that keeps the GUI from staying up is taken back after 3 starts (x6100-update)
    [ -x /usr/sbin/x6100-update ] && /usr/sbin/x6100-update boot-check > /tmp/x6100-update-boot.txt 2>&1
    /usr/sbin/x6100_gui > /tmp/x6100_log.txt 2>&1 || sync; mv /tmp/x6100_log.txt /mnt/app_logs/x6100_log_$(date +%Y-%m-%d_%H-%M-%S).txt
done
